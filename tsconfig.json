{
    "include": [
      "src",
      "src/**/*",
      "src/**/*.ts",
      "./src/**/*.ts",
      "./src/**/*.tsx",
      "src/types/**/*.d.ts",
    ],
    "exclude": [
      "node_modules",
      "**/*.spec.ts",
      "**/*.spec.tsx",
      "dist",
      "**/*.test.ts"
    ],
    "compilerOptions": {
      "baseUrl": "./src",
      "rootDirs": ["src"],
      "paths": {
        "*":["*", "models/*"],
        "@models/*": [
          "./models/*"
        ],
        "@/*": [
          "/*"
        ],
      },
      "outDir": "./dist/",
    "sourceMap": true,
    "lib": [
      "dom",
      "dom.iterable",
      "esnext",
      "es2019",
    ],
    "alwaysStrict": true,
    "target": "esnext",
    "jsx": "preserve",
    "module": "commonjs", //к какому типу приводится
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true, //также включает noImplicitAny
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noImplicitAny": true, //не допускает выведенных типов Any, только явные
  }
}
